# Mapa de calor do ARI medio
library(readxl)
library(dplyr)
library(purrr)
library(ggplot2)
library(scales)
# Pasta contendo as nove planilhas
pasta = "."
cenarios = c("A1", "A2", "A3",
"B1", "B2", "B3",
"C1", "C2", "C3")
arquivos = file.path(
pasta,
paste0("resultados_simulacoes_", cenarios, ".xlsx")
)
if (!all(file.exists(arquivos))) {
stop("Planilhas nao encontradas: ",
paste(basename(arquivos[!file.exists(arquivos)]), collapse = ", "))
}
